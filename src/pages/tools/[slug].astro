---
import Base from '../../layouts/Base.astro'; import SpecTable from '../../components/SpecTable.astro'; import Card from '../../components/Card.astro';
import { tools, CATS, u, pairsFor, pairSlug, bySlug } from '../../lib/site.js';
export function getStaticPaths(){ return tools.map(t=>({params:{slug:t.slug},props:{t}})); }
const { t } = Astro.props;
const peers = tools.filter(x=>x.category===t.category&&x.slug!==t.slug).sort((a,b)=>a.name.localeCompare(b.name));
const rel = tools.filter(x=>x.category===t.category&&x.slug!==t.slug).slice(0,3);
const jsonld={"@context":"https://schema.org","@type":"SoftwareApplication",name:t.name,description:t.description,url:t.url,applicationCategory:"ScientificApplication",operatingSystem:"Any",license:t.license,isAccessibleForFree:!['Paid','Contact'].includes(t.pricing),...(t.github?{codeRepository:t.github}:{}),...(t.paper?{citation:t.paper}:{}),keywords:t.tags.join(', ')};
---
<Base title={`${t.name} — ${CATS[t.category][0]} | Toolome`} description={`${t.name}: ${t.description}`} jsonld={jsonld}>
<p><a href={u('/category/'+t.category+'/')}>← {CATS[t.category][0]}</a></p>
<h1>{t.name}</h1><p style="font-size:18px">{t.description}</p>
<p><a class="btn" href={t.url} rel="noopener" target="_blank">Visit website ↗</a></p>
<table><tr><th>Category</th><td>{CATS[t.category][0]}</td></tr>
{t.github&&<tr><th>GitHub</th><td><a href={t.github}>{t.github.replace('https://github.com/','')}</a></td></tr>}
{t.released&&<tr><th>Released</th><td>{t.released} (<a href={t.source}>source</a>)</td></tr>}
{!t.released&&t.firstReleased&&<tr><th>First public</th><td>{t.firstReleased} (<a href={t.dateSource}>source</a>)</td></tr>}
{t.paper&&<tr><th>Paper</th><td><a href={t.paper}>{t.paper}</a></td></tr>}
<tr><th>License</th><td>{t.license}</td></tr><tr><th>Pricing</th><td>{t.pricing}</td></tr>
<tr><th>Tags</th><td>{t.tags.map(g=><span class="tag">#{g}</span>)}</td></tr><tr><th>Last checked</th><td>{t.lastChecked}</td></tr></table>
{pairsFor(t.slug).length>0&&<p class="mut">Compare with… {pairsFor(t.slug).map((p,i)=>{const o=bySlug[p[0]===t.slug?p[1]:p[0]];return <>{i>0&&' · '}<a href={u('/compare/'+pairSlug(p)+'/')}>{t.name} vs {o.name}</a></>})}</p>}
<h2>Specs</h2><SpecTable list={[t]}/>
{peers.length>0&&<section class="picker" id="compare"><h2>Compare with…</h2>
<p class="mut">Pick 1–3 other {CATS[t.category][0]} tools to compare side by side with {t.name}.</p>
<form action={u('/compare/')} method="get" data-self={t.slug}><input type="hidden" name="c" value={t.category}/><input type="hidden" name="t" value={t.slug}/>
<div class="pk">{peers.map(x=><label><input type="checkbox" value={x.slug}/> {x.name}</label>)}</div>
<p><button class="btn" type="submit" disabled>Compare</button> <span class="mut pkn" aria-live="polite">Select 1–3 tools</span></p></form></section>}
<script is:inline>document.querySelectorAll('.picker form').forEach(f=>{const bx=[...f.querySelectorAll('.pk input')],b=f.querySelector('button'),n=f.querySelector('.pkn'),h=f.querySelector('input[name=t]');const up=()=>{const s=bx.filter(x=>x.checked);bx.forEach(x=>x.disabled=!x.checked&&s.length>=3);b.disabled=!s.length;n.textContent=s.length?(s.length+1)+' tools selected':'Select 1–3 tools';h.value=[f.dataset.self,...s.map(x=>x.value)].join(',')};bx.forEach(x=>x.addEventListener('change',up));f.addEventListener('submit',e=>{e.preventDefault();location.href=f.action+'?c='+f.elements.c.value+'&t='+h.value});up()})</script>
<style>.pk{display:flex;flex-wrap:wrap;gap:6px}.pk label{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);border-radius:999px;padding:4px 12px;font-size:14px;cursor:pointer;min-height:36px}.pk label:has(input:checked){border-color:var(--acc);background:var(--acc-soft)}.btn[disabled]{opacity:.45;cursor:not-allowed}</style>
<h2>Related</h2><div class="grid">{rel.map(x=><Card t={x}/>)}</div>
</Base>
