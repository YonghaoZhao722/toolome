---
import Base from '../../layouts/Base.astro';
import { CATS, PAIRS, bySlug, pairSlug, u } from '../../lib/site.js';
export function getStaticPaths(){ return PAIRS.map(p=>({params:{pair:pairSlug(p)},props:{a:bySlug[p[0]],b:bySlug[p[1]]}})); }
const { a, b } = Astro.props;
const rows=[['Category',t=>CATS[t.category][0]],['Description',t=>t.description],['License',t=>t.license],['Pricing',t=>t.pricing],['Tags',t=>t.tags.join(', ')],['Released',t=>t.released||'—']];
const shared=a.tags.filter(x=>b.tags.includes(x));
const jsonld={"@context":"https://schema.org","@type":"WebPage",name:`${a.name} vs ${b.name}`,about:[a,b].map(t=>({"@type":"SoftwareApplication",name:t.name,url:t.url,license:t.license,applicationCategory:"ScientificApplication"}))};
---
<Base title={`${a.name} vs ${b.name} (2026): license, pricing, links | Toolome`} description={`${a.name} vs ${b.name}: side-by-side comparison of what each does, license, pricing, code and paper.`} jsonld={jsonld}>
<h1>{a.name} vs {b.name}</h1>
<p><b>{a.name}</b>: {a.description} <b>{b.name}</b>: {b.description}</p>
<p class="mut">Facts below come from each project's own website, repository and paper. We don't publish benchmark claims here; see the papers for evaluations.{shared.length>0&&` Shared tags: ${shared.join(', ')}.`}</p>
<table><tr><th scope="col">Field</th><th><a href={u('/tools/'+a.slug+'/')}>{a.name}</a></th><th><a href={u('/tools/'+b.slug+'/')}>{b.name}</a></th></tr>
{rows.map(([k,f])=><tr><th>{k}</th><td>{f(a)}</td><td>{f(b)}</td></tr>)}
<tr><th>Website</th><td><a href={a.url}>Visit ↗</a></td><td><a href={b.url}>Visit ↗</a></td></tr>
<tr><th>Code</th><td>{a.github?<a href={a.github}>GitHub</a>:'—'}</td><td>{b.github?<a href={b.github}>GitHub</a>:'—'}</td></tr>
<tr><th>Paper</th><td>{a.paper?<a href={a.paper}>Paper</a>:'—'}</td><td>{b.paper?<a href={b.paper}>Paper</a>:'—'}</td></tr></table>
<h2>More comparisons</h2><ul>{PAIRS.map(p=><li><a href={u('/compare/'+pairSlug(p)+'/')}>{bySlug[p[0]].name} vs {bySlug[p[1]].name}</a></li>)}</ul>
<p><a href={u('/category/'+a.category+'/')}>← All {CATS[a.category][0]} tools</a></p>
</Base>
