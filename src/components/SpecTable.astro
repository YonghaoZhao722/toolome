---
import { specRows, u } from '../lib/site.js';
const { list } = Astro.props;
const one=list.length===1; const skip=['License','Pricing','Released','Paper','GitHub'];
const rows = list.map(t=>specRows(t).filter(([l])=>!one||(!skip.includes(l)&&!(l==='GitHub stars'&&!t.github))));
const link = v => /^https?:/.test(v);
const show = v => link(v) ? (v.includes('github.com')?'GitHub':'Link') : v;
---
<div class="spec-wrap"><table class="spec">{!one&&<thead><tr><th scope="col">Field</th>{list.map(t=><th scope="col">{list.length>1?<a href={u('/tools/'+t.slug+'/')}>{t.name}</a>:'Value'}</th>)}</tr></thead>}
<tbody>{rows[0].map(([label],i)=><tr><th scope="row">{label}</th>{rows.map(r=>{const v=r[i][1];return <td data-l={label}>{v===''?<span class="mut">—</span>:link(v)?<a href={v}>{show(v)}</a>:v}</td>})}</tr>)}</tbody></table></div>
<style>.spec-wrap{overflow-x:auto}.spec th[scope=row]{position:sticky;left:0;background:var(--bg);white-space:nowrap}</style>
